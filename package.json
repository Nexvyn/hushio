{
  "name": "hushio-app",
  "private": true,
  "version": "1.0.1",
  "description": "A free, calm music player with no ads and no servers",
  "author": "Nexvyn",
  "homepage": "https://hushio.nexvyn.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexvyn/hushio.git"
  },
  "bugs": {
    "url": "https://github.com/Nexvyn/hushio/issues"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build:web": "vite build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "icons": "tauri icon public/hushio.svg && tauri icon public/hushio.svg --png 16 --png 24 --png 48 --png 64 --png 512 --png 1024 && node scripts/sync-app-icons.mjs",
    "android:apk": "tauri android build --apk --split-per-abi --target aarch64 armv7 x86_64 && tauri android build --apk --target aarch64 armv7 x86_64",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-http": "~2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "bgutils-js": "4.0.3",
    "motion": "14.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "youtubei.js": "18.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^26.1.0",
    "mesurer": "0.2.7",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  }
}
