<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hushio_widget_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="@drawable/hushio_widget_cover_tint"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/widget_cover_glyph"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_app_glyph" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/hushio_widget_preview_title"
            android:textColor="@color/hushio_widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/hushio_widget_preview_artist"
            android:textColor="@color/hushio_widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/hushio_widget_accent_circle"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_glyph_play" />
</LinearLayout>
