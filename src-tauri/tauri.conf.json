{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hushio",
  "version": "1.1.1",
  "identifier": "com.hushio.app",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hushio",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0a0a0a",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost localart: http://localart.localhost; media-src 'self' blob: https: http://127.0.0.1:* asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/**", "$DOWNLOAD/**", "$MUSIC/**", "$APPDATA/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Music",
    "shortDescription": "Hushio — desktop music player for Windows & macOS",
    "longDescription": "Hushio — desktop music player for Windows & macOS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["mp3", "m4a", "aac", "flac", "ogg", "oga", "opus", "wav", "webm"],
        "name": "Audio file",
        "description": "Audio file",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsi",
        "startMenuFolder": "Hushio",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "libsecret-1-0",
          "xdg-utils",
          "xdg-desktop-portal"
        ],
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "linux/hushio.desktop",
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/hushio.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/hushio.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/hushio.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/hushio.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/hushio.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/hushio.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/hushio.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/hushio.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/scalable/apps/hushio.svg": "icons/scalable/hushio.svg"
        }
      },
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "librsvg2",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-libav",
          "libsecret",
          "xdg-utils",
          "xdg-desktop-portal"
        ],
        "desktopTemplate": "linux/hushio.desktop",
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/hushio.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/hushio.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/hushio.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/hushio.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/hushio.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/hushio.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/hushio.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/hushio.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/scalable/apps/hushio.svg": "icons/scalable/hushio.svg"
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RThCQ0I1RTVFNjVBMzUKUldRMVd1Ymx0YnpvaUhPdWVnQ04xNHp1RHl4SmJJaW9DRDdBenJhczVHamM1ajZLdEM4dFRZclMK",
      "endpoints": [
        "https://github.com/Nexvyn/hushio/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hushio"]
      }
    }
  }
}
