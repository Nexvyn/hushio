{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "opener:default",
    "store:default",
    "clipboard-manager:allow-write-image",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.youtube.com/*" },
        { "url": "https://music.youtube.com/*" },
        { "url": "https://*.googlevideo.com/*" },
        { "url": "https://jnn-pa.googleapis.com/*" },
        { "url": "https://pipedapi.kavin.rocks/*" },
        { "url": "https://pipedapi.adminforge.de/*" },
        { "url": "https://api.piped.private.coffee/*" },
        { "url": "https://open.spotify.com/*" },
        { "url": "https://spotify.link/*" },
        { "url": "https://api-partner.spotify.com/*" }
      ]
    }
  ]
}
